[submodule "nanobench"]
	path = vega-engine/vendor/nanobench
	url = https://github.com/martinus/nanobench.git
[submodule "spdlog"]
	path = vega-engine/vendor/spdlog
	url = https://github.com/gabime/spdlog.git
